name: Update pet

on:
  schedule:
    - cron: "0 */6 * * *"   # runs every 6 hours
  workflow_dispatch:         # lets you run it by hand

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Update pet
        env:
          PET_USER: ${{ github.repository_owner }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: python scripts/update_pet.py

      - name: Save changes
        run: |
          git config user.name "pet-bot"
          git config user.email "pet-bot@users.noreply.github.com"
          git add pet/pet.svg
          git diff --staged --quiet || (git commit -m "Update pet" && git push)
